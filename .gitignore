# ============================================================
#  futa_gtnh — Git 忽略规则
# ============================================================

# ---- 构建产物 / 本地环境（GTNH ExampleMod 默认项） ----
.gradle
.settings
/.idea/
/.vscode/
/run/
/build/
/eclipse/
